generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the transaction pooler (port 6543).
  url       = env("DATABASE_URL")
  // Migrations need a session connection (port 5432): the pooler cannot hold
  // the advisory lock or run DDL, so migrate commands hang against it.
  directUrl = env("DIRECT_URL")
}

model City {
  id      String @id @default(uuid())
  name    String
  slug    String @unique
  country String

  /// Local and translated names from GeoNames, lowercased and de-accented.
  /// Searched alongside `name` so "Viyana" finds Vienna and "Prag" finds Prague.
  searchAliases String[]

  // Coordinates drive the map's city markers; population and geonameId come
  // from the GeoNames import that replaces the NUTS region list.
  latitude   Float?
  longitude  Float?
  population Int?
  geonameId  Int?   @unique

  // Cached Unsplash result: fetching a photo per request cannot serve the
  // trending lists or profile favourites.
  imageUrl         String?
  imageAttribution String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   Review[]
  visits    Visit[]
  wishlists WishlistItem[]
  favorites FavoriteCity[]
}

model Review {
  id      String @id @default(uuid())
  content String

  // Stored on a 1–10 scale so half stars are exact integers: 7 means 3.5
  // stars. See lib/review.ts for the conversion helpers.
  culture      Int
  gastronomy   Int
  safety       Int
  socialLife   Int
  transport    Int
  costOfLiving Int

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  isApproved Boolean @default(false)

  likes    ReviewLike[]
  comments ReviewComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per user per city — the application-level check alone loses
  // the race when two submissions land concurrently.
  @@unique([cityId, userId])
  @@index([cityId])
  @@index([createdAt])
  @@index([userId])
}

/// A city the user has been to, optionally with the dates they were there.
/// Replaces the implicit many-to-many, which had nowhere to put the dates.
model Visit {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cityId])
  @@index([userId])
  @@index([cityId])
}

/// A city the user wants to go to.
model WishlistItem {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, cityId])
  @@index([userId])
  @@index([cityId])
}

/// The four cities pinned at the top of a profile. `position` is 0–3 and is
/// unique per user, so the slots cannot collide.
model FavoriteCity {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  position Int

  createdAt DateTime @default(now())

  @@unique([userId, position])
  @@unique([userId, cityId])
  @@index([userId])
}

model ReviewLike {
  id String @id @default(uuid())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@index([reviewId])
}

/// A reply to a review. Single level: replies cannot themselves be replied to.
model ReviewComment {
  id String @id @default(uuid())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId, createdAt])
  @@index([userId])
}

model User {
  id String @id @default(uuid())

  /// Shown as the user typed it, so display casing is preserved.
  username      String? @unique
  /// Lowercase mirror of `username`. Uniqueness and every lookup go through
  /// this column, so "Ada" and "ada" cannot both exist.
  usernameLower String? @unique

  name          String?
  email         String    @unique
  password      String? // Credentials login için
  emailVerified DateTime?
  image         String?
  bio           String?   @db.Text
  /// Free-text "where I'm based", shown on the profile header. Optional.
  location      String?
  role          Role      @default(USER)
  banned        Boolean   @default(false)

  accounts       Account[]
  sessions       Session[]
  reviews        Review[]
  visits         Visit[]
  wishlist       WishlistItem[]
  favoriteCities FavoriteCity[]
  reviewLikes    ReviewLike[]
  reviewComments ReviewComment[]

  /// People this user follows / who follow this user.
  following Follow[] @relation("follower")
  followers Follow[] @relation("following")
  /// People this user has blocked / who have blocked this user.
  blocking  Block[]  @relation("blocker")
  blockedBy Block[]  @relation("blocked")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A directed follow edge. `followerId` follows `followingId`.
model Follow {
  id String @id @default(uuid())

  followerId String
  follower   User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// A directed block edge. `blockerId` no longer sees `blockedId` anywhere, and
/// neither can follow the other.
model Block {
  id String @id @default(uuid())

  blockerId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

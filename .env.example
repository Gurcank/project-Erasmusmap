# PostgreSQL connection string (e.g. Supabase). Required.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random secret used to sign NextAuth session tokens. Required.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL NextAuth uses for callbacks. Required.
# Use http://localhost:3000 in development.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (Google Cloud Console). Required for Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Mapbox GL access token (exposed to the browser). Required for the map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Unsplash API access key, used server-side to fetch city photos. Required.
UNSPLASH_ACCESS_KEY=

# Public site URL used for metadata/Open Graph/sitemap. Optional — defaults
# to the production URL if unset; set this in preview/local environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string (e.g. Supabase). Required.
# If using Supabase's connection pooler, use the *transaction* mode port
# (6543, with ?pgbouncer=true) — the session mode port (5432) can fail to
# resolve the tenant/user in serverless environments.
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true

# Session-mode connection (port 5432, no pgbouncer param), used only by
# Prisma migrate and seed. The transaction pooler cannot hold the advisory
# lock or run DDL, so migrate commands hang against it. Required.
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Random secret used to sign NextAuth session tokens. Required.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL NextAuth uses for callbacks. Required.
# Use http://localhost:3000 in development.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (Google Cloud Console). Required for Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Mapbox GL access token (exposed to the browser). Required for the map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Unsplash API access key, used server-side to fetch city photos. Required.
UNSPLASH_ACCESS_KEY=

# Public site URL used for metadata/Open Graph/sitemap. Optional — defaults
# to the production URL if unset; set this in preview/local environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and service-role key, used server-side to store
# avatar images in the `avatars` Storage bucket. Required for photo upload.
# The service-role key bypasses row-level security — never expose it to the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis REST credentials for rate limiting. Optional — without them
# the limiter falls back to a per-instance in-memory window, which does not
# hold across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
